{
  "schemaVersion": "2.2",
  "description": "Deploy any pushed branch commit of descon-be to this instance (preview policy: branch and PR deploys).",
  "parameters": {
    "commitSha": {
      "type": "String",
      "description": "Full 40-character lowercase commit SHA.",
      "allowedPattern": "^[0-9a-f]{40}$"
    }
  },
  "mainSteps": [
    {
      "action": "aws:runShellScript",
      "name": "deployBackend",
      "inputs": {
        "timeoutSeconds": "1800",
        "runCommand": [
          "runuser -u deploy -- /usr/local/sbin/descon-deploy-backend --any-pushed-commit {{ commitSha }}"
        ]
      }
    }
  ]
}
