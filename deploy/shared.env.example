
# Template for /home/deploy/descon-mps-api/shared/.env on the instance.
# Copy it there, fill in the values, then:  chmod 0600 .env && chown deploy:deploy .env
#
# Format (read identically by systemd EnvironmentFile= and deploy/bin/with-env):
# KEY=value, one per line, NO quotes, NO `export`, NO spaces around `=`.
# Never commit the filled-in file or paste it into a ticket/chat.

# --- Rails / Puma -----------------------------------------------------------
RAILS_ENV=production
# staging = the mock malware scanner is permitted (see the runbook, "Malware
# scanning in the test environment"). Change to production when a real
# scanner is integrated.
APP_ENV=staging
RAILS_MASTER_KEY=
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=3
# Solid Queue runs inside Puma so a 2 GiB host carries one Ruby process.
# Remove the line to disable; `SOLID_QUEUE_IN_PUMA=` or `=false` also mean off.
SOLID_QUEUE_IN_PUMA=1
# async = supervisor, worker, dispatcher and scheduler as threads in the Puma
# process (measured ~1 process); fork = their own processes (~5). See the
# runbook, "Where Solid Queue runs".
SOLID_QUEUE_MODE=async
JOB_CONCURRENCY=1
FORCE_SSL=true

# --- Database: private RDS, four logical databases ---------------------------
DB_HOST=descon-mps-db.czkga408o68a.ap-southeast-1.rds.amazonaws.com
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=descon_mps_production
CACHE_DB_NAME=descon_mps_production_cache
QUEUE_DB_NAME=descon_mps_production_queue
CABLE_DB_NAME=descon_mps_production_cable
# One process runs 3 request threads and 3 job threads against the primary
# and queue databases (async mode), so the pool must cover both; still well
# below the connection limit of a 1 GiB RDS instance.
DB_POOL=10
# Verified TLS (libpq reads these for the application AND pg_dump/psql).
# Download the bundle once:
#   https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
PGSSLMODE=verify-full
PGSSLROOTCERT=/etc/ssl/rds/global-bundle.pem

# --- Secrets generated for this deployment (never reuse across environments) -
JWT_SECRET=
INVITATION_TOKEN_SECRET=
# Keep a separate, offline copy of these three: losing them makes encrypted
# CNIC/passport columns unreadable. Generate with `bin/rails db:encryption:init`.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
JWT_ISSUER=descon_backend
JWT_AUDIENCE=rails_api_clients
CANDIDATE_JWT_AUDIENCE=candidate_api_clients

# --- Public origin (one origin serves the web app and /api/v1) ---------------
# The web app and API share this domain. Update the protected shared/.env
# on the instance separately; this example is not loaded automatically.
CORS_ALLOWED_ORIGINS=https://descon-mps.com
FRONTEND_PAYMENT_RETURN_URL=https://descon-mps.com/payment/pending
KUICKPAY_RETURN_URL=https://descon-mps.com/api/v1/payments/hosted_checkout/kuickpay/return

# --- Object storage: private S3 through the EC2 instance role -----------------
ACTIVE_STORAGE_SERVICE=amazon
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=descon-mps-documents-s3-bucket
# Leave AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY UNSET: the SDK uses the
# instance role. deployment:preflight warns if they are present.

# --- Document handling --------------------------------------------------------
# A real scanner is not integrated yet. `mock` is accepted only while
# APP_ENV=staging and scans NOTHING except the EICAR test signature.
# Production runs with `none` (and APP_ENV=production): uploads are accepted
# WITHOUT any malware scan. This is a recorded, deliberate decision -- see the
# runbook, "Malware scanning". Unset it to refuse all uploads instead.
DOCUMENT_MALWARE_SCANNER=mock
DOCUMENT_OCR_ENABLED=false

# --- Integrations (secrets for these live in encrypted credentials) -----------
SMS_PROVIDER=test
KUICKPAY_ENABLED=false
# Automatic voice calls per workflow stage (RoboCall plays a fixed recorded voice; the stage -> voice ID setup is
# in the admin app under "Automatic calls"). The RoboCall api key lives in the encrypted credentials
# (robocall.production.api_key). Set AI_VOICE_OUTBOUND_ENABLED=true to start placing calls; it is also the kill switch.
AI_VOICE_PROVIDER=robocall
AI_VOICE_OUTBOUND_ENABLED=false
# RoboCall retries unanswered calls itself (Call Settings). A "no answer" is final only after this many
# minutes: set it to retry delay x number of retries plus a few minutes.
ROBOCALL_RETRY_WINDOW_MINUTES=30
