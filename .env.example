RAILS_ENV=development

# Primary PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_POOL=15
DB_NAME=descon_development
DB_STATEMENT_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=2000

# Solid Cache / Queue / Cable PostgreSQL databases
CACHE_DB_NAME=descon_development_cache
QUEUE_DB_NAME=descon_development_queue
CABLE_DB_NAME=descon_development_cable

# Test databases used by RSpec and other test commands
TEST_DB_NAME=descon_test
TEST_CACHE_DB_NAME=descon_test_cache
TEST_QUEUE_DB_NAME=descon_test_queue
TEST_CABLE_DB_NAME=descon_test_cable

# Frontend origins allowed by CORS
CORS_ALLOWED_ORIGINS=http://localhost:4000,http://localhost:8081

# Authentication and token settings
JWT_SECRET=replace-me-with-a-long-random-secret
INVITATION_TOKEN_SECRET=replace-me-with-a-dedicated-invitation-token-secret
JWT_ISSUER=descon_backend
JWT_AUDIENCE=rails_api_clients
DEVISE_MAILER_SENDER=no-reply@example.com
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=replace-me-with-a-32-byte-encryption-key
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=replace-me-with-a-32-byte-deterministic-key
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=replace-me-with-a-32-byte-key-derivation-salt

# Candidate (CNIC + OTP) authentication settings
CANDIDATE_JWT_AUDIENCE=candidate_api_clients
CANDIDATE_ACCESS_TOKEN_TTL_MINUTES=15
CANDIDATE_REFRESH_TOKEN_EXPIRY_DAYS=30
CANDIDATE_REFRESH_RATE_LIMIT_PER_MINUTE=30
CANDIDATE_DOCUMENT_MAX_BYTES=5242880
PCC_NEAR_EXPIRY_DAYS=30
SEED_DEMO_DATA=false
OTP_CODE_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_PER_MINUTE=10
OTP_IDENTITY_RATE_LIMIT_PER_MINUTE=5
CANDIDATE_IMPORT_MAX_BYTES=2097152
CANDIDATE_IMPORT_MAX_ROWS=1000

# SMS provider selection ("test" sends nothing real; "sendpk" is a real
# vendor -- see app/services/sms/)
SMS_PROVIDER=test

# send.pk Fixed/OTP SMS (https://sendpk.com/blog/fixed-sms-api/) -- the SMS
# wording is a template approved in the send.pk dashboard
# (Template Management); OTP_TEMPLATE_ID is that template's id and it
# must use the variables #code# and #minutes#. SENDPK_SENDER_ID is the
# sender value your account expects. Sends fail without the api key
# (credentials), sender and template.
# The API key is NOT an env var: put it in encrypted credentials
# (bin/rails credentials:edit -> sendpk: development/production: api_key).
SENDPK_SENDER_ID=
OTP_TEMPLATE_ID=
# Optional Urdu template (Unicode) -- used for Urdu candidates; falls back to
# OTP_TEMPLATE_ID when blank.
OTP_TEMPLATE_ID_UR=
SENDPK_BASE_URL=https://sendpk.com
SENDPK_OPEN_TIMEOUT_SECONDS=5
SENDPK_READ_TIMEOUT_SECONDS=10

# Hosted checkout payment settings. KuickPay is the only integrated
# provider (Payments::Configuration#provider_code); KUICKPAY_ENABLED below
# is the kill switch -- while it's false, checkout requests fail safely
# with payment_checkout_unavailable instead of reaching KuickPay.
ONBOARDING_FEE_AMOUNT=1500.00
PAYMENT_CURRENCY_CODE=PKR
PAYMENT_CHECKOUT_EXPIRES_IN_MINUTES=30
# KuickPay hosted checkout (POST {KUICKPAY_BASE_URL}/checkout/api/session --
# see Payments::Providers::KuickpayHostedCheckoutAdapter). KUICKPAY_COMPANY_ID
# is what KuickPay's own dashboard/docs may label "Institution ID" -- same
# value, used as the Basic Auth username and as `companyid` in every request.
# The SecuredKey is NOT an env var: put it in encrypted credentials
# (bin/rails credentials:edit -> kuickpay: development/production: secured_key).
KUICKPAY_ENABLED=true
KUICKPAY_COMPANY_ID=01234
KUICKPAY_BASE_URL=https://sandbox-api.kuickpay.com
KUICKPAY_RETURN_URL=http://localhost:3000/api/v1/payments/hosted_checkout/kuickpay/return
KUICKPAY_OPEN_TIMEOUT_SECONDS=5
KUICKPAY_READ_TIMEOUT_SECONDS=10
# Where HostedCheckoutReturnsController redirects the candidate's browser after
# processing the provider's signed return (success or failure) -- the frontend's
# unauthenticated payment-pending page, never a JSON body.
FRONTEND_PAYMENT_RETURN_URL=http://localhost:4000/payment/pending

# Passport/CNIC/Next-of-Kin-CNIC OCR extraction (AWS Textract). Disabled
# until credentials, region and sandbox verification are completed --
# extraction failures never block manual HR document processing.
DOCUMENT_OCR_ENABLED=false
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DOCUMENT_OCR_TIMEOUT_SECONDS=10

# Localization
APP_SUPPORTED_LOCALES=en,ur

# Request and rate-limiting controls
MAX_REQUEST_BODY_SIZE_BYTES=5242880
API_RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=20
AUTH_IDENTITY_RATE_LIMIT_PER_MINUTE=10
AUTH_REFRESH_TOKEN_RATE_LIMIT_PER_MINUTE=10
STAFF_INVITATION_ACCEPT_RATE_LIMIT_PER_MINUTE=10
ADMIN_DOCUMENT_ACCESS_TTL_SECONDS=300

# Production-oriented runtime settings
# Local development may use `local`. Production must set this to an approved
# durable private storage service and will fail to boot if it is omitted.
ACTIVE_STORAGE_SERVICE=local
FORCE_SSL=true
RAILS_LOG_LEVEL=info
JOB_CONCURRENCY=1
